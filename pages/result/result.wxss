.result-hero {
  padding: 52rpx 36rpx 44rpx;
  border-radius: 34rpx;
  background: linear-gradient(150deg, #4f46e5 0%, #7c3aed 55%, #a855f7 100%);
  box-shadow: 0 20rpx 44rpx rgba(79, 70, 229, 0.3);
  text-align: center;
  color: #ffffff;
}

.result-emoji {
  font-size: 76rpx;
  line-height: 1;
}

.result-title {
  display: block;
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.result-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
}

.score-box {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 30rpx;
}

.score-num {
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
}

.score-unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---------- 指标条 ---------- */
.metrics {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 30rpx 12rpx;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #161a2b;
  line-height: 1.2;
}

.metric-warn {
  color: #ef4d6a;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8f96a6;
}

.metric-line {
  width: 2rpx;
  height: 48rpx;
  background: #eff1f7;
}

/* ---------- 分区 ---------- */
.section-head {
  display: flex;
  align-items: baseline;
  margin: 44rpx 4rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #161a2b;
}

.section-sub {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: #9aa1b1;
}

/* ---------- 错题 ---------- */
.wrong-card {
  padding: 8rpx 28rpx;
}

.wrong-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f3f4f9;
}

.wrong-item:last-child {
  border-bottom: none;
}

.wrong-en {
  font-size: 30rpx;
  font-weight: 600;
  color: #161a2b;
}

.wrong-phonetic {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #a3a9b6;
}

.wrong-zh {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #7c8394;
}

/* ---------- 按钮 ---------- */
.actions {
  margin-top: 44rpx;
}

.action-ghost {
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 40rpx;
}
