.quiz-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* ---------- 顶部进度 ---------- */
.hud {
  margin-bottom: 28rpx;
}

.progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: #e8eaf2;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5b5bd6, #a855f7);
  transition: width 0.3s ease;
}

.hud-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.hud-index {
  font-size: 26rpx;
  font-weight: 600;
  color: #5d6475;
}

.hearts {
  display: flex;
  align-items: center;
}

.heart {
  margin: 0 4rpx;
  font-size: 30rpx;
  color: #ef4d6a;
  line-height: 1;
}

.heart-off {
  color: #dfe2ec;
}

.hud-score {
  font-size: 26rpx;
  font-weight: 600;
  color: #5b5bd6;
}

/* ---------- 题干 ---------- */
.q-card {
  position: relative;
  padding: 48rpx 32rpx 44rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(22, 26, 43, 0.07);
  text-align: center;
}

.q-tag {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f1fd;
}

.q-tag-text {
  font-size: 22rpx;
  color: #5b5bd6;
  letter-spacing: 1rpx;
}

.q-prompt {
  display: block;
  margin-top: 26rpx;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #14182a;
  word-break: break-word;
}

.q-phonetic {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #9aa1b1;
}

/* ---------- 选项 ---------- */
.options {
  margin-top: 32rpx;
}

.opt {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #eceef5;
  box-shadow: 0 6rpx 20rpx rgba(22, 26, 43, 0.04);
  transition: all 0.16s ease;
}

.opt:active {
  transform: scale(0.99);
}

.opt-letter {
  width: 52rpx;
  height: 52rpx;
  margin-right: 22rpx;
  border-radius: 14rpx;
  background: #f3f4fa;
  color: #7c8394;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 52rpx;
}

.opt-text {
  flex: 1;
  font-size: 30rpx;
  color: #1c2130;
  line-height: 1.4;
}

.opt-right {
  background: #eefaf3;
  border-color: #34b46b;
}

.opt-right .opt-letter {
  background: #34b46b;
  color: #ffffff;
}

.opt-right .opt-text {
  color: #14663a;
  font-weight: 600;
}

.opt-wrong {
  background: #fdeff1;
  border-color: #ef4d6a;
}

.opt-wrong .opt-letter {
  background: #ef4d6a;
  color: #ffffff;
}

.opt-wrong .opt-text {
  color: #a3162f;
  font-weight: 600;
}

.opt-dim {
  opacity: 0.55;
}

/* ---------- 反馈面板 ---------- */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 44rpx rgba(20, 24, 42, 0.14);
  animation: rise 0.22s ease-out;
}

@keyframes rise {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet-head {
  display: flex;
  align-items: center;
}

.sheet-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
}

.i-ok {
  background: #34b46b;
}

.i-no {
  background: #ef4d6a;
}

.sheet-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c2130;
}

.sheet-combo {
  margin-left: auto;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3e0;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 600;
}

.sheet-word {
  display: flex;
  align-items: baseline;
  margin-top: 18rpx;
}

.sheet-en {
  font-size: 38rpx;
  font-weight: 700;
  color: #14182a;
}

.sheet-phonetic {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #9aa1b1;
}

.sheet-zh {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #4a5164;
}

.sheet-example {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #2c3142;
}

.sheet-example-zh {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8f96a6;
}

.sheet-note {
  display: block;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #f7f6ff;
  font-size: 23rpx;
  line-height: 1.55;
  color: #5b5bd6;
}

.sheet-btn {
  margin-top: 26rpx;
  height: 92rpx;
}
