{
  "description": "AI 界面英文 · 测验闯关小程序（纯本地）",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": ".workbuddy"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "LICENSE"
      }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "minified": true,
    "postcss": true,
    "urlCheck": true
  },
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "ai-ui-english",
  "miniprogramRoot": "./"
}
